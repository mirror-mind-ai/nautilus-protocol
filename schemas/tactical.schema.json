{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nautilus.local/protocol/v1/tactical.schema.json",
  "title": "Nautilus Tactical Projection v1",
  "type": "object",
  "required": ["contractVersion", "schemaVersion", "journeyId", "altitude", "namespace", "projection", "snapshotId", "generatedAt", "producer", "sourceRevision", "sourceSnapshots", "content"],
  "properties": {
    "contractVersion": {"const": "1.0"}, "schemaVersion": {"const": "1"},
    "journeyId": {"type": "string"}, "altitude": {"const": "tactical"},
    "namespace": {"const": "nautilus-synthesis"}, "projection": {"const": "tactical"},
    "snapshotId": {"type": "string"}, "generatedAt": {"type": "string", "format": "date-time"},
    "producer": {"type": "object"}, "sourceRevision": {"type": "string"},
    "sourceSnapshots": {"type": "array", "minItems": 1},
    "content": {
      "type": "object", "additionalProperties": false,
      "required": ["mission", "evidence", "deliverables"],
      "properties": {
        "mission": {"$ref": "#/$defs/mission"},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
        "deliverables": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/deliverable"}},
        "meaningCheckpoints": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/meaningCheckpoint"}}
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "mission": {"type": "object", "additionalProperties": false, "required": ["id", "title", "purpose"], "properties": {"id": {"type": "string"}, "title": {"type": "string"}, "purpose": {"type": "string"}}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["id", "title", "summary", "sourceReferences"], "properties": {"id": {"type": "string"}, "title": {"type": "string"}, "summary": {"type": "string"}, "sourceReferences": {"$ref": "#/$defs/sources"}}},
    "deliverable": {"type": "object", "additionalProperties": false, "required": ["id", "title", "summary", "evidenceIds", "sourceReferences"], "properties": {"id": {"type": "string"}, "title": {"type": "string"}, "summary": {"type": "string"}, "evidenceIds": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "sourceReferences": {"$ref": "#/$defs/sources"}}},
    "meaningCheckpoint": {"type": "object", "additionalProperties": false, "required": ["id", "title", "summary", "state", "sourceReferences"], "properties": {"id": {"type": "string", "minLength": 1}, "title": {"type": "string", "minLength": 1}, "summary": {"type": "string", "minLength": 1}, "state": {"enum": ["provisional", "consolidated", "contested", "correction_requested", "stale"]}, "sourceReferences": {"$ref": "#/$defs/sources"}, "correctionBoundary": {"type": "string", "minLength": 1}}}
  }
}
