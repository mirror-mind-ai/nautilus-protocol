{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nautilus.local/protocol/v1/strategic.schema.json",
  "title": "Nautilus Strategic Projection v1",
  "type": "object",
  "required": ["contractVersion", "schemaVersion", "journeyId", "altitude", "namespace", "projection", "snapshotId", "generatedAt", "producer", "sourceRevision", "sourceSnapshots", "content"],
  "properties": {
    "contractVersion": {"const": "1.0"}, "schemaVersion": {"const": "1"},
    "journeyId": {"type": "string"}, "altitude": {"const": "strategic"},
    "namespace": {"const": "nautilus-synthesis"}, "projection": {"const": "strategic"},
    "snapshotId": {"type": "string"}, "generatedAt": {"type": "string", "format": "date-time"},
    "producer": {"type": "object"}, "sourceRevision": {"type": "string"},
    "sourceSnapshots": {"type": "array", "minItems": 1},
    "content": {
      "type": "object", "additionalProperties": false,
      "required": ["realizations", "impacts"],
      "properties": {
        "realizations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/realization"}},
        "impacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/impact"}}
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "value": {"type": "object", "additionalProperties": false, "required": ["summary", "sourceReferences"], "properties": {"summary": {"type": "string"}, "sourceReferences": {"$ref": "#/$defs/sources"}}},
    "impact": {"type": "object", "additionalProperties": false, "required": ["id", "title", "summary", "sourceReferences"], "properties": {"id": {"type": "string"}, "title": {"type": "string"}, "summary": {"type": "string"}, "sourceReferences": {"$ref": "#/$defs/sources"}}},
    "realization": {"type": "object", "additionalProperties": false, "required": ["id", "title", "summary", "impactIds", "pragmaticValue", "integrativeValue", "sourceReferences"], "properties": {"id": {"type": "string"}, "title": {"type": "string"}, "summary": {"type": "string"}, "impactIds": {"type": "array", "items": {"type": "string"}}, "pragmaticValue": {"$ref": "#/$defs/value"}, "integrativeValue": {"$ref": "#/$defs/value"}, "sourceReferences": {"$ref": "#/$defs/sources"}}}
  }
}
